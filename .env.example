# Copia este archivo como .env y cambia los valores. .env no se sube al repositorio.
#
# Las contraseñas de SQL Server deben tener al menos 8 caracteres con mayúsculas, minúsculas,
# números y símbolos. No uses ; ni comillas simples: rompen la cadena de conexión.

# Contraseña del administrador (sa) de SQL Server. Solo la usa db-init para crear la base.
MSSQL_SA_PASSWORD=Cambia-Esta-Clave-1

# Contraseña del usuario con el que se conecta la API (solo lee y escribe datos).
APP_DB_PASSWORD=Cambia-Esta-Otra-2

# Clave con la que la API firma los tokens. Al menos 32 caracteres, aleatoria.
# Para generar una:  openssl rand -base64 48
JWT_KEY=cambia-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres
